{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/curso", "destination": "/curso.html" }
  ],
  "headers": [
    {
      "source": "/guia.pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "inline; filename=\"guia.pdf\"" }
      ]
    }
  ]
}
